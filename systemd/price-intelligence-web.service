[Unit]
Description=Price Intelligence — the shelf, for the bot's button
Documentation=https://github.com/Whyslab/price-intelligence
After=network-online.target
Wants=network-online.target

[Service]
# Reached from the phone through `tailscale serve --https=10000` (tailnet only)
# and opened by Telegram as a mini-app, where the page carries Telegram's
# signature — that is who a reader is. Never add --owner here: behind the
# Tailscale proxy every request arrives from 127.0.0.1, and --owner would make
# everybody who reaches this port the owner.
Type=simple
WorkingDirectory=%h/Projects/price-intelligence
ExecStart=%h/Projects/price-intelligence/.venv/bin/python -m pi web --host 127.0.0.1 --port 8000
Restart=always
RestartSec=10
Nice=10

# Stars are written to the database; nothing else.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Projects/price-intelligence/data
NoNewPrivileges=yes

[Install]
WantedBy=default.target
