[Unit]
Description=Price Intelligence — collect prices and alert on real discounts
Documentation=https://github.com/Whyslab/price-intelligence
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/price-intelligence
ExecStart=%h/Projects/price-intelligence/.venv/bin/python -m pi run
# A run must finish well inside the hour before the next one: up to ten minutes
# waiting its turn behind a prune or a rebuild (pi.db.collector_lock), then a
# sweep of a quarter of an hour. Anything approaching this is stuck.
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle

# It only needs its own directory and the network.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Projects/price-intelligence/data
NoNewPrivileges=yes
