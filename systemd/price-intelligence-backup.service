[Unit]
Description=Price Intelligence — consistent database snapshot for the backup

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/price-intelligence
ExecStart=%h/Projects/price-intelligence/.venv/bin/python -m pi backup
TimeoutStartSec=30min
Nice=15
IOSchedulingClass=idle

PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Projects/price-intelligence/data
NoNewPrivileges=yes
