# Telegram — get the token from @BotFather, the chat id from @userinfobot
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=123456789

# Optional. Defaults shown.
PI_DB_PATH=data/pi.db
PI_SITES_FILE=data/sites.txt
PI_FILTERS_FILE=filters.toml
PI_CONCURRENCY=8
# Shopify rate-limits our IP across its whole platform, not per shop, so this is
# one shared budget for every Shopify store. Going much above 2 earns a 429 that
# lasts minutes and carries no Retry-After.
PI_SHOPIFY_RATE=2.0
PI_LOG_LEVEL=INFO
