# Telegram — get the token from @BotFather, the chat id from @userinfobot
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=123456789

# Optional. Defaults shown.
PI_DB_PATH=data/pi.db
PI_SITES_FILE=data/sites.txt
PI_FILTERS_FILE=filters.toml
PI_CONCURRENCY=8
# Shopify blocks the whole IP, across every shop, if pushed too hard — and once
# it does, no request rate gets through for twenty minutes or more. PI_SHOPIFY_RATE
# is the sweep's overall budget; PI_SHOPIFY_HOST_RATE is what any one shop gets.
# 2.0 overall is the setting observed to complete a full sweep with zero refusals.
PI_SHOPIFY_RATE=2.0
PI_SHOPIFY_HOST_RATE=0.5
PI_LOG_LEVEL=INFO
