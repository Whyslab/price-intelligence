# Telegram — get the token from @BotFather, the chat id from @userinfobot
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=123456789

# Optional. Defaults shown.
PI_DB_PATH=data/pi.db
PI_SITES_FILE=data/sites.txt
PI_FILTERS_FILE=filters.toml
PI_CONCURRENCY=8
# Shopify blocks the whole IP, across every shop, if pushed too hard — and once
# it does, no request rate gets through for twenty minutes or more. PI_SHOPIFY_RATE
# is the sweep's overall budget; PI_SHOPIFY_HOST_RATE is what any one shop gets.
# 2.0 overall is the setting observed to complete a full sweep with zero refusals.
PI_SHOPIFY_RATE=2.0
PI_SHOPIFY_HOST_RATE=0.5

# Shopify's quota tolerates a few dozen stores at a time, so each run takes a
# slice rather than charging at all of them and being cut off part-way. Runs go
# through the list least-recently-collected first, so four runs a day at 45
# cover 138 stores comfortably. Set to 0 to sweep everything in one go.
PI_MAX_SHOPIFY_STORES=45
PI_LOG_LEVEL=INFO

# Где витрина (`pi web`) доступна снаружи. Без неё в боте просто нет кнопки.
# По https Telegram откроет её мини-приложением, по http — ссылкой в браузере.
# PI_WEB_URL=https://shelf.example.com
# PI_WEB_PRIVATE=on   # the shelf is reachable only on your own tailnet: show its button to the owner alone

# --- продажа доступа --------------------------------------------------------
# Подписка построена целиком и выключена: полка открыта, бот ничего не предлагает,
# дайджесту некому рекламировать. Состояние оплат при этом не стирается, поэтому
# включение возобновляет продажу, а не начинает её заново.
#
# `on` — продаём. Любое другое значение, включая отсутствие строки, — нет.
# Прежде чем ставить `on`, прочитайте docs/subscription.md: там шесть шагов, и
# пятый — провести настоящий платёж и возврат.
# PI_SUBSCRIPTION=on
