# Copy to filters.toml and edit. Every key is optional; the defaults are shown.
# Nothing here is a secret, but filters.toml is gitignored so your personal
# sizes and brands stay out of the repository.

# --- how big a discount has to be -------------------------------------------
# Both thresholds must be met. The absolute one matters: 40% off a $30 t-shirt
# is $12 and not worth a notification.
min_discount_pct = 30.0     # percent below the reference price
min_saving_usd   = 40.0     # dollars saved

# Ignore anything outside this range entirely.
min_price_usd = 25.0
max_price_usd = 2000.0

# Deal score is 0-100. Roughly: 30% off scores ~48, 50% off ~80, and an
# all-time low on corroborated history adds 20 on top.
min_score = 55

# At most this many notifications per run (runs happen every 6 hours).
max_alerts_per_run = 15
# And at most this many from any one shop. A shop that puts -40% on its whole
# catalogue otherwise fills the whole run on its own: twelve notifications in a
# row, every one of them the same shop at the same percentage.
max_alerts_per_store = 3

# --- what counts as the price it was before ----------------------------------
# The reference is the lowest price the shop actually charged in this many days
# before the drop. This is the EU's formula, and it is what a price raised last
# week to be "discounted" this week cannot survive: 200 put up to 300 for seven
# days and back to 200 leaves the floor at 200, so the discount is zero.
reference_window_days = 30

# Products are matched between shops on the manufacturer's article number, so a
# price can be judged against what everyone else is asking even with no history
# at all. Both settings are counts of *other* shops that must stock the article.
# Two, not three: at three the market price covered 45,929 products of 449,243,
# at two it covers 98,678. The median of two shops is noisier than of three, so
# if false "discounts" start arriving, this is the first thing to put back.
market_min_shops = 2   # before their prices are treated as the market price
# A recommended price is a claim about the brand rather than about one shop, so
# this one keeps its third witness.
msrp_min_shops   = 3   # before their struck-through prices imply an RRP

# A struck-through price this many percent above that RRP is the shop's own
# invention, and is not used as a reference at all.
inflated_tag_pct = 15

# A shop whose discounts nearly all land on a round 5% step is applying "-40% to
# this category", not remembering what things used to cost: a real former price
# produces 36.4% and 22.8%, and lands on a round step about as often as chance
# allows. Measured across 78 shops, individual pricing sits near 55% and rule
# pricing at 100%. Above this share, the shop's struck-through prices stop
# counting as evidence.
rule_priced_share = 0.9

# The same conclusion from a different shape: this share of the catalogue sitting
# at one identical percentage, round or not.
blanket_sale_share = 0.3

# A struck-through price that has not moved in this many days is not a sale,
# it is the normal price with decoration. Such deals are scored down heavily.
fake_sale_days = 21

# --- what you actually want --------------------------------------------------
# Matched as case-insensitive substrings of the brand name.
# brands_allow is a whitelist: leave it empty to accept every brand.
brands_allow = []
# e.g. brands_allow = ["nike", "jordan", "new balance", "asics", "salomon"]

brands_deny = []
# e.g. brands_deny = ["crocs"]

# Sizes are normalised to forms like "US10.5", "EU44", "UK9", "M", "XL".
# Leave empty to accept any size. Normalisation is best effort: a bare "44"
# is read as EU44 and a bare "10" as US10, which is right most of the time
# but not always, so prefer listing several forms of your size.
# List every regional form of your size: the catalogue is labelled mostly in US
# sizes — 1,422,974 variants against 318,482 in EU and 49,529 in UK — so an
# EU-only filter throws away most of what is on offer. Half sizes too: shops
# round the conversion differently.
sizes = []
# e.g. footwear EU 44-45 plus clothing L-XL:
# sizes = [
#     "EU44", "EU44.5", "EU45", "US10", "US10.5", "US11", "UK9", "UK9.5", "UK10",
#     "L", "XL", "L/XL",
# ]
# Listing only shoe sizes silently drops all clothing: it is sized S/M/L/XL, and
# one-size accessories are "OS".
